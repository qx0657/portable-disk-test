          ".impeccable/review/model-base-ocr-dark.png",
          ".impeccable/review/model-base-overview.png"
        ],
        "privacy": "Captures stay local; OCR uses a SYNTHETIC label and no fixture is saved to user records."
      }
    }
  },
  "components": [
    {
      "name": "原生主操作（说明性预览）",
      "kind": "button",
      "description": "对应 tinted borderedProminent；实际外观和焦点由 macOS 管理。",
      "html": "<button class=\"ds-primary\">打开 AmorphousDiskMark</button>",
      "css": ".ds-primary{font-family:system-ui,-apple-system,sans-serif;font-size:12px;background:#246458;color:#fff;border:0;border-radius:6px;padding:6px 12px;font-weight:500;cursor:pointer}.ds-primary:hover{filter:brightness(1.08)}.ds-primary:focus-visible{outline:3px solid #246458;outline-offset:3px}.ds-primary:active{filter:brightness(.92)}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-color-scheme:dark){.ds-primary{background:#81CBB5;color:#18211E}.ds-primary:focus-visible{outline-color:#81CBB5}}",
      "refersTo": "button-prominent"
    },
    {
      "name": "原生次操作（说明性预览）",
      "kind": "button",
      "description": "扫描和导出采用系统 bordered；预览不定义新的 AppKit 尺寸 token。",
      "html": "<button class=\"ds-secondary\">重新扫描</button>",
      "css": ".ds-secondary{font-family:system-ui,-apple-system,sans-serif;font-size:12px;background:ButtonFace;color:ButtonText;border:1px solid #DCE6E0;border-radius:6px;padding:5px 10px;cursor:pointer}.ds-secondary:hover{filter:brightness(.97)}.ds-secondary:focus-visible{outline:3px solid #246458;outline-offset:3px}.ds-secondary:active{filter:brightness(.9)}.ds-secondary:disabled{opacity:.45}@media(prefers-color-scheme:dark){.ds-secondary{border-color:#34453D}.ds-secondary:focus-visible{outline-color:#81CBB5}}"
    },
    {
      "name": "SMART 搜索",
      "kind": "input",
      "description": "可见标签与辅助名称；搜索指标名称、当前值或说明。",
      "html": "<label class=\"ds-search\">搜索指标 <input aria-label=\"搜索 SMART 指标\" placeholder=\"\" type=\"search\"/></label>",
      "css": ".ds-search{font-family:system-ui,-apple-system,sans-serif;font-size:12px;display:flex;gap:10px;align-items:center;color:#50665E}.ds-search input{width:220px;font:inherit;color:CanvasText;background:Field;border:1px solid #DCE6E0;border-radius:5px;padding:4px 6px}.ds-search input:hover{border-color:#50665E}.ds-search input:focus-visible{outline:3px solid #246458;outline-offset:2px}@media(prefers-color-scheme:dark){.ds-search{color:#B0C4BA}.ds-search input{border-color:#34453D}.ds-search input:focus-visible{outline-color:#81CBB5}}",
      "refersTo": "smart-search"
    },
    {
      "name": "设备导航选中行",
      "kind": "nav",
      "description": "名称、容量与状态同在一行块，身份信息不随页面切换消失。",
      "html": "<button class=\"ds-device\" aria-current=\"true\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M5 4h14l3 11v5H2v-5L5 4Z M2 15h20 M17 18h2\"/></svg><span><strong>Extreme Pro</strong><small>4.00 TB · SSD</small><small>● SMART 通过</small></span></button>",
      "css": ".ds-device{font-family:system-ui,-apple-system,sans-serif;font-size:12px;display:flex;gap:11px;align-items:flex-start;background:#24574C;color:#fff;border:0;border-radius:12px;padding:13px;text-align:left;width:212px;cursor:pointer}.ds-device svg{margin-top:2px;width:30px;height:25px}.ds-device strong{display:block;font-size:13px;font-weight:600}.ds-device small{display:block;font-size:11px;margin-top:6px;opacity:.9}.ds-device:hover{filter:brightness(1.06)}.ds-device:focus-visible{outline:3px solid #246458;outline-offset:3px}.ds-device:active{filter:brightness(.95)}@media(prefers-color-scheme:dark){.ds-device{background:#2C6051}.ds-device:focus-visible{outline-color:#81CBB5}}",
      "refersTo": "device-row-selected"
    },
    {
      "name": "SMART 健康徽章",
      "kind": "chip",
      "description": "文字、状态色与图形共同传达健康；未知状态不使用通过绿。",
      "html": "<span class=\"ds-health\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"10\" cy=\"10\" r=\"8\"/><path d=\"m6 10 3 3 5-6\"/></svg>检查通过</span>",
      "css": ".ds-health{font-family:system-ui,-apple-system,sans-serif;font-size:12px;display:inline-flex;align-items:center;gap:5px;color:#286A49;background:rgba(40,106,73,.09);font-weight:500;border-radius:999px;padding:7px 11px}@media(prefers-color-scheme:dark){.ds-health{color:#87D5A3;background:rgba(135,213,163,.09)}}",
      "refersTo": "health-passed"
    },
    {
      "name": "测速准备容器",
      "kind": "card",
      "description": "平面色阶与留白承载准备信息，避免自定义阴影。",
      "html": "<section class=\"ds-panel\"><h3>测速准备</h3><p><span>目标卷</span><strong>Extreme Pro</strong></p><p><span>建议参数</span><strong>3 次 · 4 GiB · MB/s</strong></p><small>打开后请手动选择目标卷和参数，再点击 All。</small></section>",
      "css": ".ds-panel{font-family:system-ui,-apple-system,sans-serif;font-size:12px;background:#F0F5F2;color:CanvasText;border-radius:14px;padding:20px;max-width:620px}.ds-panel h3{font-size:14px;font-weight:600;margin:0 0 16px}.ds-panel p{display:flex;gap:16px;align-items:baseline;margin:16px 0}.ds-panel p span{width:58px;color:#50665E}.ds-panel strong{font-size:13px;font-weight:500;font-variant-numeric:tabular-nums}.ds-panel small{color:#50665E;font-size:12px}@media(prefers-color-scheme:dark){.ds-panel{background:#202E28}.ds-panel p span,.ds-panel small{color:#B0C4BA}}",
      "refersTo": "preparation-panel"
    },
    {
      "name": "设备信息分段选择（说明性预览）",
      "kind": "nav",
      "description": "原生 segmented Picker 在真实应用处理选择、焦点与键盘；预览只呈现形状。",
      "html": "<div class=\"ds-segment\" role=\"group\" aria-label=\"设备信息分类\"><button aria-pressed=\"true\">概览</button><button aria-pressed=\"false\">SMART</button><button aria-pressed=\"false\">测速</button></div>",
      "css": ".ds-segment{display:flex;width:294px;border:1px solid #DCE6E0;border-radius:6px;overflow:visible;background:ButtonFace}.ds-segment button{font-family:system-ui,-apple-system,sans-serif;font-size:12px;flex:1;border:0;background:transparent;color:ButtonText;padding:4px 12px;border-radius:5px;cursor:pointer}.ds-segment button[aria-pressed=\"true\"]{background:rgba(80,102,94,.14)}.ds-segment button:hover{background:rgba(80,102,94,.1)}.ds-segment button:focus-visible{outline:3px solid #246458;outline-offset:2px}.ds-segment button:active{filter:brightness(.9)}@media(prefers-color-scheme:dark){.ds-segment{border-color:#34453D}.ds-segment button:focus-visible{outline-color:#81CBB5}}"
    },
    {
      "name": "空间容量轨",
      "kind": "custom",
      "description": "文字提供可访问的已用与可用容量；轨道只显示真实比例。",
      "html": "<section class=\"ds-volume\"><div><strong>Extreme Pro</strong><span>4.00 TB</span></div><div class=\"ds-volume-track\" role=\"img\" aria-label=\"已用 1.00 TB，可用 3.00 TB\"><i></i></div><small>已用 1.00 TB · 可用 3.00 TB</small></section>",
      "css": ".ds-volume{font-family:system-ui,-apple-system,sans-serif;font-size:12px;color:CanvasText;max-width:620px}.ds-volume>div:first-child{display:flex;justify-content:space-between;margin-bottom:9px;font-variant-numeric:tabular-nums}.ds-volume strong{font-weight:500}.ds-volume-track{height:6px;border-radius:3px;background:#DCE6E0;overflow:hidden}.ds-volume-track i{display:block;height:100%;width:25%;border-radius:3px;background:#246458}.ds-volume small{display:block;margin-top:9px;font-size:11px;color:#50665E}@media(prefers-color-scheme:dark){.ds-volume-track{background:#34453D}.ds-volume-track i{background:#81CBB5}.ds-volume small{color:#B0C4BA}}"
    },
    {
      "name": "测速读写成绩",
      "kind": "custom",
      "description": "读写各有标题、数值和颜色；长度相对同份成绩最大值，示例数字不是设备指标。",
      "html": "<div class=\"ds-benchmark\" aria-label=\"示例成绩，读取 1000.00 MB/s，写入 800.00 MB/s\"><strong>SEQ1M<br><small>QD 8</small></strong><div><small>读取 MB/s</small><b>1000.00</b><i class=\"ds-read\"></i></div><div><small>写入 MB/s</small><b>800.00</b><i class=\"ds-write\"></i></div></div>",
      "css": ".ds-benchmark{font-family:system-ui,-apple-system,sans-serif;font-size:12px;display:flex;gap:16px;color:CanvasText;border-bottom:1px solid #DCE6E0;padding:12px 0;max-width:620px}.ds-benchmark>strong{font-weight:500;width:129px}.ds-benchmark>div{flex:1}.ds-benchmark small{font-size:11px;color:#50665E}.ds-benchmark b{display:block;font-size:21px;font-weight:600;font-variant-numeric:tabular-nums;margin:7px 0}.ds-benchmark i{display:block;height:4px;border-radius:2px}.ds-read{background:#246458;width:100%}.ds-write{background:#486E8B;width:80%}@media(prefers-color-scheme:dark){.ds-benchmark{border-color:#34453D}.ds-benchmark small{color:#B0C4BA}.ds-read{background:#81CBB5}.ds-write{background:#91B7D5}}"
    }
  ],
  "narrative": {
    "northStar": "森林步道导览",
    "overview": "松绿、石白和有秩序的数据层级，形成适合长时间查看的原生 Mac 工具。稳定的设备身份是路径标记；概览、SMART 与测速是同一台设备的三个观察层次。界面以紧凑、清楚和舒适为准，不将设备检查包装成虚构分数。\n\n本文件从已实现的 SwiftUI / AppKit 应用提取。主要依据是 `Sources/DiskApp/Views.swift`、`DeviceIdentityViews.swift`、`SMARTView.swift`、`SpeedView.swift`、`Main.swift` 与 `AppModel.swift`，并核对桌面及深色捕获。前言中的尺寸使用 macOS 逻辑点（pt），不是屏幕物理像素；字体由系统及中文回退字体解析。系统控件的边框、焦点和禁用外观由 macOS 管理，不虚构其固定色值。",
    "keyCharacteristics": [
      "深浅色成对的松绿表面，少量蓝色区分测速写入。",
      "原生双栏、分段选择、按钮与渐进披露；数据区保持平面。",
      "等宽数字配合明确单位、来源与缺失状态。",
      "多盘身份持续可见，历史与测速成绩只关联可靠身份。"
    ],
    "rules": [
      {
        "name": "The Semantic State Rule",
        "body": "状态色必须跟随真实状态；选中设备和测速的强调色不得被解读为健康通过。异常、未提供及部分读取始终附带文字解释。",
        "section": "colors"
      },
      {
        "name": "The Measured Number Rule",
        "body": "测量值使用等宽数字与真实单位。未知值显示 `—` 或“未提供”，不以零占位；厂商原始值不改写为健康百分比。",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "数据面板保持平面；通过语义色阶与清晰对齐建立层次，保留系统控件自己的深度反馈。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 成对维护深浅色语义，保留系统 `.primary` 正文与原生焦点反馈。",
      "**Do** 让设备身份、数据时间、单位与具体读取限制始终可查。",
      "**Do** 让状态同时有文字与图形，测量值使用等宽数字。",
      "**Do** 在保存测速成绩前保留目标设备确认，并只关联可靠身份。",
      "**Do** 尊重系统减少动态效果，保持原生键盘与 VoiceOver 语义。"
    ],
    "donts": [
      "**Don't** 编造健康总分、接口速率、寿命结论或缺失指标；未知值不填零。",
      "**Don't** 把 USB4 产品名当作已观测连接，或把历史断电计数直接标为故障。",
      "**Don't** 在身份不可靠时跨会话保存，或静默猜测测速成绩属于哪块盘。",
      "**Don't** 将打开第三方测速工具写成已经启动测试；应用不会自动写入硬盘。",
      "**Don't** 给平面数据区增加自定义投影、装饰动画或非原生展示字体。"
    ]
  }
}
